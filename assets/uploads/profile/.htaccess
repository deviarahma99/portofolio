# Uploaded images only — never execute scripts from this folder.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(?i:php|php\d|phtml|phar|pht|cgi|pl|py|asp|aspx|sh|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -ExecCGI -Indexes
RemoveHandler .php .php3 .php4 .php5 .phtml .pl .py .cgi .asp .aspx
AddType text/plain .php .php3 .php4 .php5 .phtml .pl .py .cgi .asp .aspx
